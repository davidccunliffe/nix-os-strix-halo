# Template for /var/lib/hermes/env (mode 0600).
# Install with:
#   sudo install -m 0600 /dev/stdin /var/lib/hermes/env < this-file
# OPENAI_API_KEY must equal LLAMA_API_KEY: Hermes authenticates against
# the local llama-server. If auth fails, check `hermes config` and the
# Hermes Environment Variables reference for the exact variable name.
OPENAI_API_KEY=change-me-long-random

# Uncomment when enabling the messaging gateway
# (extraDependencyGroups = [ "messaging" ] in modules/hermes.nix):
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_USERS=your-numeric-user-id
