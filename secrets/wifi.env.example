# Template for /var/lib/wifi/env (root-owned, mode 0600). The key name
# psk_foxyap is referenced as pskRaw = "ext:psk_foxyap" in configuration.nix.
# Install on a running system with:
#   sudo install -d -m 0700 /var/lib/wifi
#   echo 'psk_foxyap=your-wifi-password' | sudo install -m 0600 /dev/stdin /var/lib/wifi/env
# During nixos-install (before the first reboot) target the mounted system
# instead, so the box comes up on Wi-Fi headless:
#   sudo install -d -m 0700 /mnt/var/lib/wifi
#   echo 'psk_foxyap=your-wifi-password' | sudo install -m 0600 /dev/stdin /mnt/var/lib/wifi/env
psk_foxyap=change-me
