# Template for /var/lib/wifi/env. The key name psk_foxyap is referenced as
# pskRaw = "ext:psk_foxyap" in configuration.nix.
#
# Ownership matters: the NixOS wpa_supplicant unit is hardened and runs as
# User=wpa_supplicant, and it opens this file *after* dropping privileges.
# root:root 0600 is unreadable to it — the journal says "EXT PW FILE: could
# not open file '/var/lib/wifi/env': Permission denied" and the box comes up
# with no network. It must be group-readable by wpa_supplicant.
#
# Install on a running system with:
#   sudo install -d -m 0750 -g wpa_supplicant /var/lib/wifi
#   echo 'psk_foxyap=your-wifi-password' \
#     | sudo install -m 0640 -g wpa_supplicant /dev/stdin /var/lib/wifi/env
#
# During nixos-install (before the first reboot) target the mounted system
# instead, so the box comes up on Wi-Fi headless. The ISO has no
# wpa_supplicant user, so write it root-owned and let the systemd.tmpfiles
# rule in configuration.nix fix the ownership on first boot:
#   sudo install -d -m 0700 /mnt/var/lib/wifi
#   echo 'psk_foxyap=your-wifi-password' | sudo install -m 0600 /dev/stdin /mnt/var/lib/wifi/env
psk_foxyap=change-me
